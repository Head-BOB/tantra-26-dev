# Tantra 26 Backend Environment Variables
PORT=5000
NODE_ENV=production

# Supabase Project Credentials (from Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for Admin Authentication (Generate a long random string)
JWT_SECRET=tantra26_super_secure_jwt_secret_key_change_in_production

# Frontend Origin for CORS (e.g., your Vercel deployment URL)
FRONTEND_URL=https://tantra26.vercel.app,http://localhost:5173
